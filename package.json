{
  "name": "inboxkitten",
  "version": "1.0.0",
  "description": "A personal disposable email service",
  "main": "index.js",
  "scripts": {
    "start": "concurrently \"npm run api\" \"npm run ui\"",
    "api": "cd api && node app.js",
    "ui": "cd ui && vite",
    "build": "npm run build:ui",
    "build:api": "echo 'No build step required for API'",
    "build:ui": "npm install --prefix ui && node -e \"require('fs').copyFileSync('ui/config/apiconfig.sample.js', 'ui/config/apiconfig.js')\" && cd ui && npm run build && cd .. && node fix-ui-vars.js",
    "preview": "cd ui && vite preview",
    "test": "mocha",
    "type-check": "npm run type-check:ui",
    "type-check:ui": "cd ui && tsc --noEmit",
    "docker:build": "docker build -t akunlama .",
    "docker:run": "docker run -p 8000:8000 --env-file ./.env akunlama"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "body-parser": "^1.20.2",
    "clipboard": "^2.0.11",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.11.0",
    "firebase-functions": "^4.4.1",
    "jquery": "^3.7.1",
    "kittenrouter": "^1.0.3",
    "mailgun-js": "^0.22.0",
    "moment": "^2.29.4",
    "normalize.css": "^8.0.1",
    "pinia": "^2.1.0",
    "primer-tooltips": "^2.0.0",
    "random-words": "^2.0.0",
    "sass": "^1.69.5",
    "validator": "^13.11.0",
    "vue": "^3.3.0",
    "vue-router": "^4.2.0"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.7",
    "@types/validator": "^13.11.7",
    "@vitejs/plugin-vue": "^4.5.0",
    "concurrently": "^8.2.0",
    "delay": "^5.0.0",
    "md5": "^2.3.0",
    "mocha": "^10.2.0",
    "shortid": "^2.2.16",
    "ts-node": "^10.9.1",
    "typescript": "^5.3.0",
    "uuid": "^9.0.1",
    "vite": "^4.5.0",
    "vue-tsc": "^1.8.25",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "keywords": [
    "inboxkitten",
    "email",
    "disposable"
  ],
  "author": "uilicious",
  "license": "MIT"
}