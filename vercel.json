{
    "version": 2,
    "builds": [
        {
            "src": "backend/app.js",
            "use": "@vercel/node",
            "config": {
                "includeFiles": [
                    "backend/**"
                ]
            }
        },
        {
            "src": "ui/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        }
    ],
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/app.js"
        },
        {
            "source": "/assets/(.*)",
            "destination": "ui/assets/$1"
        },
        {
            "source": "/static/(.*)",
            "destination": "ui/static/$1"
        },
        {
            "source": "/favicon.ico",
            "destination": "ui/static/favicon.ico"
        },
        {
            "source": "/((?!api/|assets/|static/|favicon.ico).*)",
            "destination": "ui/index.html"
        }
    ]
}