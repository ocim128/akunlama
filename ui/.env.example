# API URL (default to production if not set)
VITE_API_URL=https://akunlama.com/api

# Website Domain
VITE_WEBSITE_DOMAIN=akunlama.com

# Auto-refresh interval (ms)
VITE_AUTO_REFRESH_INTERVAL=30000

# API request timeout (ms)
VITE_REQUEST_TIMEOUT=10000

# Maximum emails to display
VITE_MAX_EMAILS_DISPLAY=50

# Retention period display text
VITE_RETENTION_PERIOD="3 days"

# Feature Flags
VITE_ENABLE_PULL_TO_REFRESH=true
VITE_ENABLE_STREAMING=true
