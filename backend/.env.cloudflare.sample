# =====================================
# CLOUDFLARE EMAIL API CONFIGURATION
# =====================================
# Copy this to .env and update with your values
MAIL_CONFIG=CLOUDFLARE
# Cloudflare Worker API URL (your deployed API worker)
CLOUDFLARE_API_URL=https://curly-wood-ce28.k3yt07.workers.dev

# Your email domain
EMAIL_DOMAIN=akunlama.com

# Admin access key (optional - for viewing all emails)
ADMIN_ACCESS_KEY=your-secret-admin-key-here

# =====================================
# RATE LIMITING AND SECURITY
# =====================================
BANNED_IPS=
BANNED_USERNAMES=

# =====================================
# EMAIL FILTERING (saves server load and quota)
# =====================================
# Block emails containing these keywords in the sender address (comma-separated, case-insensitive)
# Example: noreply,newsletter,marketing,spam
BLOCKED_SENDER_KEYWORDS=

# Block emails containing these keywords in the subject (comma-separated, case-insensitive)
# Example: unsubscribe,verify your email,promotional offer
BLOCKED_SUBJECT_KEYWORDS=

# Block emails containing these keywords in the body (comma-separated, case-insensitive)
# Example: click here to unsubscribe,this is an automated message
BLOCKED_BODY_KEYWORDS=

# =====================================
# LEGACY MAILGUN CONFIG (NOT NEEDED FOR CLOUDFLARE)
# =====================================
# MAILGUN_API_KEY=key-xxxxxxxxxx
# MAILGUN_EMAIL_DOMAIN=yourdomain.com

