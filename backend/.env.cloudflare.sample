# =====================================
# CLOUDFLARE EMAIL API CONFIGURATION
# =====================================
# Copy this to .env and update with your values
MAIL_CONFIG=CLOUDFLARE
# Cloudflare Worker API URL (your deployed API worker)
CLOUDFLARE_API_URL=https://curly-wood-ce28.k3yt07.workers.dev

# Your email domain
EMAIL_DOMAIN=gratis-ongkir.com

# Admin access key (optional - for viewing all emails)
ADMIN_ACCESS_KEY=your-secret-admin-key-here

# Rate limiting and security
BANNED_IPS=
BANNED_USERNAMES=

# =====================================
# LEGACY MAILGUN CONFIG (NOT NEEDED FOR CLOUDFLARE)
# =====================================
# MAILGUN_API_KEY=key-xxxxxxxxxx
# MAILGUN_EMAIL_DOMAIN=yourdomain.com
